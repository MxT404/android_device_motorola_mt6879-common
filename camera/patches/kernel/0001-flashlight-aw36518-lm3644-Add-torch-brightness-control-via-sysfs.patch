From f905e501bcf8b06723f35de2804b4b18fd8f50ad Mon Sep 17 00:00:00 2001
From: MxT404 <MxT404@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:09:23 +0000
Subject: [PATCH] flashlight: aw36518/lm3644: Add torch brightness control via
 sysfs

The MediaTek flash LED drivers keep the torch brightness in a 7 bit
register (0x00 - 0x7F), bit 7 of the AW36518 one being a hardware
override bit which has to stay cleared. Up to now userspace had no way
to change the torch brightness, the V4L2_CID_FLASH_TORCH_INTENSITY value
written by the camera HAL (and the hardcoded 25000 uA of the legacy
/dev/flashlight path) were used as is.

Expose a torch_brightness sysfs node on the I2C client device of both
the AW36518 and the LM3644 V4L2 flash drivers, which accepts the raw
register value:

  echo 64 > /sys/bus/i2c/devices/<bus>-0063/torch_brightness

While the torch is on the new level is written to the hardware right
away, and the override is also honoured for later
V4L2_CID_FLASH_TORCH_INTENSITY updates and for the legacy
FLASH_IOC_SET_ONOFF ioctl, so the level survives torch off/on cycles.
Writing 0 drops the override and hands the torch back to the camera HAL.

Signed-off-by: MxT404 <MxT404@users.noreply.github.com>
---
 .../misc/mediatek/flashlight/v4l2/aw36518.c   | 88 ++++++++++++++++++-
 .../misc/mediatek/flashlight/v4l2/lm3644.c    | 84 +++++++++++++++++-
 2 files changed, 167 insertions(+), 5 deletions(-)

diff --git a/drivers/misc/mediatek/flashlight/v4l2/aw36518.c b/drivers/misc/mediatek/flashlight/v4l2/aw36518.c
index 0388311..14920b3 100644
--- a/drivers/misc/mediatek/flashlight/v4l2/aw36518.c
+++ b/drivers/misc/mediatek/flashlight/v4l2/aw36518.c
@@ -2,6 +2,7 @@
 // Copyright (c) 2019 MediaTek Inc.
 
 #include <linux/delay.h>
+#include <linux/device.h>
 #include <linux/module.h>
 #include <linux/i2c.h>
 #include <linux/slab.h>
@@ -73,6 +74,13 @@
 #define aw36518_TORCH_BRT_REG_TO_uA(a)		\
 	((a) * aw36518_TORCH_BRT_STEP + aw36518_TORCH_BRT_MIN)
 
+/*
+ * The torch brightness register is 7 bit wide (0x00 - 0x7F). Bit 7 is a
+ * hardware override bit which has to stay cleared, so torch brightness
+ * requested through the sysfs interface is limited to the 7 bit range.
+ */
+#define aw36518_TORCH_BRT_REG_MAX 0x7F
+
 #define aw36518_COOLER_MAX_STATE 5
 static const int flash_state_to_current_limit[aw36518_COOLER_MAX_STATE] = {
 	100000, 80000, 60000, 40000, 20000
@@ -132,6 +140,8 @@ struct aw36518_flash {
 	unsigned long target_state;
 	unsigned long target_current;
 	unsigned long ori_current;
+	/* userspace torch brightness override, 0 == not overridden */
+	u32 torch_brt_ovr;
 };
 
 /* define usage count */
@@ -212,7 +222,8 @@ static int aw36518_torch_brt_ctrl(struct aw36518_flash *flash,
 		}
 	}
 
-	br_bits = aw36518_TORCH_BRT_uA_TO_REG(brt);
+	/* keep the hardware override bit (bit 7) cleared */
+	br_bits = aw36518_TORCH_BRT_uA_TO_REG(brt) & aw36518_TORCH_BRT_REG_MAX;
 
 	rval = regmap_update_bits(flash->regmap,
 					  REG_LED0_TORCH_BR, 0xff, br_bits);
@@ -362,7 +373,12 @@ static int aw36518_set_ctrl(struct v4l2_ctrl *ctrl, enum aw36518_led_id led_no)
 		break;
 
 	case V4L2_CID_FLASH_TORCH_INTENSITY:
-		rval = aw36518_torch_brt_ctrl(flash, led_no, ctrl->val);
+		if (flash->torch_brt_ovr)
+			rval = aw36518_torch_brt_ctrl(flash, led_no,
+				aw36518_TORCH_BRT_REG_TO_uA(
+					flash->torch_brt_ovr));
+		else
+			rval = aw36518_torch_brt_ctrl(flash, led_no, ctrl->val);
 		break;
 	}
 
@@ -634,7 +650,11 @@ static int aw36518_ioctl(unsigned int cmd, unsigned long arg)
 		pr_info_ratelimited("FLASH_IOC_SET_ONOFF(%d): %d\n",
 				channel, (int)fl_arg->arg);
 		if ((int)fl_arg->arg) {
-			aw36518_torch_brt_ctrl(aw36518_flash_data, channel, 25000);
+			aw36518_torch_brt_ctrl(aw36518_flash_data, channel,
+				aw36518_flash_data->torch_brt_ovr ?
+				aw36518_TORCH_BRT_REG_TO_uA(
+					aw36518_flash_data->torch_brt_ovr) :
+				25000);
 			aw36518_flash_data->led_mode = V4L2_FLASH_LED_MODE_TORCH;
 			aw36518_mode_ctrl(aw36518_flash_data);
 			aw36518_enable_ctrl(aw36518_flash_data, channel, true);
@@ -758,6 +778,61 @@ static struct thermal_cooling_device_ops aw36518_cooling_ops = {
 	.set_cur_state		= aw36518_cooling_set_cur_state,
 };
 
+/* torch brightness sysfs */
+static ssize_t torch_brightness_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct aw36518_flash *flash = dev_get_drvdata(dev);
+	u32 level;
+
+	if (!flash)
+		return -ENODEV;
+
+	mutex_lock(&flash->lock);
+	if (flash->torch_brt_ovr)
+		level = flash->torch_brt_ovr;
+	else if (flash->ori_current >= aw36518_TORCH_BRT_MIN)
+		level = aw36518_TORCH_BRT_uA_TO_REG(flash->ori_current);
+	else
+		level = 0;
+	mutex_unlock(&flash->lock);
+
+	if (level > aw36518_TORCH_BRT_REG_MAX)
+		level = aw36518_TORCH_BRT_REG_MAX;
+
+	return scnprintf(buf, PAGE_SIZE, "%u\n", level);
+}
+
+static ssize_t torch_brightness_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t size)
+{
+	struct aw36518_flash *flash = dev_get_drvdata(dev);
+	unsigned int level;
+	int ret;
+
+	if (!flash)
+		return -ENODEV;
+
+	ret = kstrtouint(buf, 10, &level);
+	if (ret)
+		return ret;
+
+	if (level > aw36518_TORCH_BRT_REG_MAX)
+		level = aw36518_TORCH_BRT_REG_MAX;
+
+	mutex_lock(&flash->lock);
+	flash->torch_brt_ovr = level;
+	if (level && flash->led_mode == V4L2_FLASH_LED_MODE_TORCH)
+		ret = aw36518_torch_brt_ctrl(flash, aw36518_LED0,
+				aw36518_TORCH_BRT_REG_TO_uA(level));
+	mutex_unlock(&flash->lock);
+
+	pr_info_ratelimited("%s: torch brightness %u\n", __func__, level);
+
+	return ret < 0 ? ret : (ssize_t)size;
+}
+static DEVICE_ATTR_RW(torch_brightness);
+
 static struct flashlight_operations aw36518_flash_ops = {
 	aw36518_flash_open,
 	aw36518_flash_release,
@@ -857,6 +932,12 @@ static int aw36518_probe(struct i2c_client *client,
 
 	i2c_set_clientdata(client, flash);
 
+	rval = device_create_file(&client->dev, &dev_attr_torch_brightness);
+	if (rval)
+		pr_info("Failed to create torch_brightness device file\n");
+	else
+		pr_info("torch brightness control enabled\n");
+
 	flash->max_state = aw36518_COOLER_MAX_STATE;
 	flash->target_state = 0;
 	flash->need_cooler = 0;
@@ -876,6 +957,7 @@ static int aw36518_remove(struct i2c_client *client)
 	struct aw36518_flash *flash = i2c_get_clientdata(client);
 	unsigned int i;
 
+	device_remove_file(&client->dev, &dev_attr_torch_brightness);
 	thermal_cooling_device_unregister(flash->cdev);
 	for (i = aw36518_LED0; i < aw36518_LED_MAX; i++) {
 		v4l2_device_unregister_subdev(&flash->subdev_led[i]);
diff --git a/drivers/misc/mediatek/flashlight/v4l2/lm3644.c b/drivers/misc/mediatek/flashlight/v4l2/lm3644.c
index 42c9a48..3f79db5 100644
--- a/drivers/misc/mediatek/flashlight/v4l2/lm3644.c
+++ b/drivers/misc/mediatek/flashlight/v4l2/lm3644.c
@@ -2,6 +2,7 @@
 // Copyright (c) 2019 MediaTek Inc.
 
 #include <linux/delay.h>
+#include <linux/device.h>
 #include <linux/module.h>
 #include <linux/i2c.h>
 #include <linux/slab.h>
@@ -70,6 +71,12 @@
 #define LM3644_TORCH_BRT_REG_TO_uA(a)		\
 	((a) * LM3644_TORCH_BRT_STEP + LM3644_TORCH_BRT_MIN)
 
+/*
+ * The torch brightness register is 7 bit wide (0x00 - 0x7F), so torch
+ * brightness requested through the sysfs interface is limited to it.
+ */
+#define LM3644_TORCH_BRT_REG_MAX 0x7F
+
 #define LM3644_COOLER_MAX_STATE 5
 static const int flash_state_to_current_limit[LM3644_COOLER_MAX_STATE] = {
 	200000, 150000, 100000, 50000, 25000
@@ -136,6 +143,8 @@ struct lm3644_flash {
 	unsigned long target_state;
 	unsigned long target_current[LM3644_LED_MAX];
 	unsigned long ori_current[LM3644_LED_MAX];
+	/* userspace torch brightness override, 0 == not overridden */
+	u32 torch_brt_ovr;
 };
 
 /* define usage count */
@@ -459,7 +468,12 @@ static int lm3644_set_ctrl(struct v4l2_ctrl *ctrl, enum lm3644_led_id led_no)
 		break;
 
 	case V4L2_CID_FLASH_TORCH_INTENSITY:
-		rval = lm3644_torch_brt_ctrl(flash, led_no, ctrl->val);
+		if (flash->torch_brt_ovr)
+			rval = lm3644_torch_brt_ctrl(flash, led_no,
+				LM3644_TORCH_BRT_REG_TO_uA(
+					flash->torch_brt_ovr));
+		else
+			rval = lm3644_torch_brt_ctrl(flash, led_no, ctrl->val);
 		break;
 	}
 
@@ -738,7 +752,11 @@ static int lm3644_ioctl(unsigned int cmd, unsigned long arg)
 		pr_info_ratelimited("FLASH_IOC_SET_ONOFF(%d): %d\n",
 				channel, (int)fl_arg->arg);
 		if ((int)fl_arg->arg) {
-			lm3644_torch_brt_ctrl(lm3644_flash_data, channel, 25000);
+			lm3644_torch_brt_ctrl(lm3644_flash_data, channel,
+				lm3644_flash_data->torch_brt_ovr ?
+				LM3644_TORCH_BRT_REG_TO_uA(
+					lm3644_flash_data->torch_brt_ovr) :
+				25000);
 			lm3644_flash_data->led_mode = V4L2_FLASH_LED_MODE_TORCH;
 			lm3644_mode_ctrl(lm3644_flash_data);
 			lm3644_enable_ctrl(lm3644_flash_data, channel, true);
@@ -867,6 +885,61 @@ static struct thermal_cooling_device_ops lm3644_cooling_ops = {
 	.set_cur_state		= lm3644_cooling_set_cur_state,
 };
 
+/* torch brightness sysfs */
+static ssize_t torch_brightness_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct lm3644_flash *flash = dev_get_drvdata(dev);
+	u32 level;
+
+	if (!flash)
+		return -ENODEV;
+
+	mutex_lock(&flash->lock);
+	if (flash->torch_brt_ovr)
+		level = flash->torch_brt_ovr;
+	else if (flash->ori_current[LM3644_LED0] >= LM3644_TORCH_BRT_MIN)
+		level = LM3644_TORCH_BRT_uA_TO_REG(flash->ori_current[LM3644_LED0]);
+	else
+		level = 0;
+	mutex_unlock(&flash->lock);
+
+	if (level > LM3644_TORCH_BRT_REG_MAX)
+		level = LM3644_TORCH_BRT_REG_MAX;
+
+	return scnprintf(buf, PAGE_SIZE, "%u\n", level);
+}
+
+static ssize_t torch_brightness_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t size)
+{
+	struct lm3644_flash *flash = dev_get_drvdata(dev);
+	unsigned int level;
+	int ret;
+
+	if (!flash)
+		return -ENODEV;
+
+	ret = kstrtouint(buf, 10, &level);
+	if (ret)
+		return ret;
+
+	if (level > LM3644_TORCH_BRT_REG_MAX)
+		level = LM3644_TORCH_BRT_REG_MAX;
+
+	mutex_lock(&flash->lock);
+	flash->torch_brt_ovr = level;
+	if (level && flash->led_mode == V4L2_FLASH_LED_MODE_TORCH)
+		ret = lm3644_torch_brt_ctrl(flash, LM3644_LED0,
+				LM3644_TORCH_BRT_REG_TO_uA(level));
